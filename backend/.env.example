# MongoDB Atlas — the same database and GridFS bucket used by the existing site.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER/harsh_portfolio?retryWrites=true&w=majority"

# HMAC secret used to sign short-lived admin sessions. At least 16 characters.
AUTH_SECRET="replace-with-a-long-random-secret"

# Seed-only values. They create the first admin only when the User collection is empty.
ADMIN_NAME="Portfolio Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional Gullu AI provider. Without a key, Gullu uses its local portfolio answers.
GULLU_API_KEY=""
GULLU_API_URL="https://api.openai.com/v1/chat/completions"
GULLU_MODEL="gpt-4o-mini"

# Comma-separated browser origins allowed to call the API directly.
FRONTEND_URL="http://localhost:3000"

# Express port.
PORT=5000
